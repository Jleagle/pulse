# Pulse Self-Hosted Environment Configuration
# Copy this file to .env or configure your keys directly inside the Pulse Web UI!

# Server Port (Default: 8080)
PORT=8080

# Google OAuth 2.0 Client Credentials (From Google Cloud Console in "Testing" status)
# Creating a project in "Testing" status with up to 100 test users is completely FREE
# and EXEMPTS you from Google's $500/year CASA AL1 security assessment!
CLIENT_ID=your-client-id.apps.googleusercontent.com
CLIENT_SECRET=your-client-secret

# Authorized Redirect URI (Must exactly match Google Cloud Console)
REDIRECT_URL=http://localhost:8080/oauth/callback
